{
  "name": "vorbi",
  "private": true,
  "version": "0.8.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --env-file-if-exists=.env.secret server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.secret server/index.js",
    "test": "node --test server/*.test.js src/*.test.js",
    "android": "vite build && cap sync android && cd android && ./gradlew assembleRelease bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@google/genai": "^1.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "concurrently": "^9.0.0",
    "vite": "^6.0.0"
  }
}
