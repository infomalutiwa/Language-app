{
  "name": "vorbi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --env-file-if-exists=.env.secret server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.secret server/index.js",
    "test": "node --test server/*.test.js src/*.test.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vite": "^6.0.0"
  }
}
