# Option A (hosting): set the plain key as a secret
# GEMINI_API_KEY=
# Option B (recommended locally): keep the key encrypted at rest.
#   GEMINI_API_KEY=... KEY_PASSPHRASE=<12+ chars> node scripts/encrypt-key.mjs   -> prints GEMINI_API_KEY_ENC
#   Put GEMINI_API_KEY_ENC in .env and KEY_PASSPHRASE in .env.secret (both git-ignored)
GEMINI_API_KEY_ENC=
# Optional. Models are discovered automatically (newest first) and fall back when a quota is used up.
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_TEXT_MODEL=
GEMINI_VOICE=Kore
DAILY_SECONDS=600
IP_DAILY_SECONDS=3600
PORT=8787
